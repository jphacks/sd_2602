{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "所有者の標準User id"
    },
    "timezone": {
      "type": "string"
    },
    "activity_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_minute": {
            "type": "integer"
          },
          "end_minute": {
            "type": "integer"
          }
        },
        "required": [
          "start_minute",
          "end_minute"
        ]
      }
    },
    "search_days": {
      "type": "integer"
    },
    "excluded_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "line_user_id": {
      "type": "string"
    },
    "line_display_name": {
      "type": "string"
    },
    "google_connection_ref": {
      "type": "string",
      "description": "接続の参照。アクセストークン等の秘密は保存しない"
    },
    "google_status": {
      "type": "string",
      "enum": [
        "unlinked",
        "linked",
        "auth_required"
      ]
    },
    "settings_version": {
      "type": "string"
    },
    "edit_version": {
      "type": "string"
    },
    "latest_snapshot_id": {
      "type": "string"
    },
    "current_run_id": {
      "type": "string"
    },
    "candidate_state": {
      "type": "string",
      "enum": [
        "valid",
        "empty",
        "invalid"
      ]
    }
  },
  "required": [
    "owner_id",
    "timezone"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
